year <- if (!is.null(meta$Date)) sub("-.*", "", meta$Date) else "2026"

bibentry(
  bibtype = "Manual",
  title = paste0("multimod: ", meta$Title),
  author = person("Oleg", "Lugovoy"),
  year = year,
  note = paste("R package version", meta$Version),
  url = "https://github.com/optimal2050/multimod"
)
